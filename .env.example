# Copy to .env for local api-server (never commit .env)

# Neon PostgreSQL connection string
DATABASE_URL=postgresql://user:pass@ep-xxx.neon.tech/neondb?sslmode=require

# From BotFather (/token) — regenerate if it was ever shared publicly
BOT_TOKEN=

# API host only (Render zoomverse-api). 12 or 24 words of the treasury TON wallet.
# Never commit the real seed. Claim airdrop cannot send on-chain without this.
TREASURY_MNEMONIC=

# Local API
PORT=3001
TG_AUTH_MODE=off
NODE_ENV=development
