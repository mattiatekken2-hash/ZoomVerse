{
  "version": 2,
  "installCommand": "corepack enable && pnpm install --frozen-lockfile",
  "buildCommand": "pnpm --filter @workspace/zoom-master run build",
  "outputDirectory": "artifacts/zoom-master/dist/public",
  "rewrites": [
    {
      "source": "/api/:path*",
      "destination": "https://zoomverse-api.onrender.com/api/:path*"
    },
    {
      "source": "/((?!assets/).*)",
      "destination": "/index.html"
    }
  ]
}
